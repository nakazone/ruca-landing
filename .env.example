# Public site URL used for metadata and JSON-LD.
# Leave unset on Vercel (or omit the variable) — an empty value breaks the build.
# NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# Optional: swap the tel: link for a CallRail (or similar) tracking number
# NEXT_PUBLIC_PHONE_HREF=tel:+17209276697

# Optional: GA4 measurement ID
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXX

# Optional: generic lead webhook (Zapier, Make, HubSpot, Sheets, etc.)
# LEAD_WEBHOOK_URL=
